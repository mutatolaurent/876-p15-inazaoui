{% extends 'base.html.twig' %}

{% block body %}
    <div class="container-fluid">
        <div class="row">
            <nav class="col-md-3 col-lg-2 d-none d-md-block bg-dark sidebar min-vh-100 p-4">
                <div class="position-sticky">
                    <h1 class="text-white">Admin</h1>
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('admin_media_index') }}">
                                Medias
                            </a>
                        </li>
                        {% if is_granted('ROLE_ADMIN') %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('admin_album_index') }}">
                                    Albums
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('admin_guest_index') }}">
                                    Invités
                                </a>
                            </li>
                        {% endif %}
                        <br>
                        <br>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('home') }}">
                                Accueil du site
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('admin_logout') }}">
                                Déconnexion
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>
            <main class="col-md-9 ms-sm-auto col-lg-10 p-4">
                {% for label, messages in app.flashes %}
                    {% set alertClass = {
                        'success': 'alert-success',
                        'error': 'alert-danger',
                        'danger': 'alert-danger',
                        'warning': 'alert-warning',
                        'info': 'alert-info',
                    }[label] ?? 'alert-info' %}

                    {% for message in messages %}
                        <div class="alert {{ alertClass }} alert-dismissible fade show" role="alert">
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                        </div>
                    {% endfor %}
                {% endfor %}
                {% block admin %}{% endblock %}
            </main>
        </div>
    </div>
{% endblock %}